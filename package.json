{
  "name": "secret-santa",
  "private": true,
  "description": "Family Secret Santa lookup and Christmas wishlists on Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply secret-santa --local",
